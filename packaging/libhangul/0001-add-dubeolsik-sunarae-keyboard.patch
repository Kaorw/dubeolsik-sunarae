+/* dubeolsik-sunarae project: 두벌식 순아래. Same physical key table as
+ * "2" (Dubeolsik); see docs/ALGORITHM.md for the input rules this adds. */
+static const HangulKeyboard hangul_keyboard_2sunarae = {
+    (char*)"2sunarae",
+    (char*)N_("Dubeolsik Sun-arae"),
+    { (ucschar*)hangul_keyboard_table_2, NULL, NULL, NULL },
+    { (HangulCombination*)&hangul_combination_2sunarae,
+      NULL,
+      (HangulCombination*)&hangul_replace_2sunarae,
+      NULL },
+    HANGUL_KEYBOARD_TYPE_JAMO_SUNARAE,
+    true
+};
+
 static const HangulKeyboard hangul_keyboard_2y = {
     (char*)"2y",
     (char*)N_("Dubeolsik Yetgeul"),
@@ -213,6 +241,7 @@ static const HangulKeyboard hangul_keyboard_ahn = {
 
 static const HangulKeyboard* hangul_builtin_keyboards[] = {
