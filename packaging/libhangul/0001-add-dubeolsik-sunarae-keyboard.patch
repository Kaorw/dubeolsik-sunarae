+/* dubeolsik-sunarae project: 두벌식 순아래 (Dubeolsik Sun-arae).
+ *
+ * This is hangul_ic_process_jamo() with one addition: while a choseong and
+ * jungseong are already buffered (no jongseong yet) and the incoming key is
+ * the SAME jungseong jamo that was just pushed (ch == hangul_ic_peek(hic)),
+ * we first try to "replace" the buffered choseong with its tense (ssang)
+ * form via the keyboard's galmadeuli/replace table (combination slot 2)
+ * instead of treating the repeated key as a second jungseong. This is what
+ * lets 까/따/빠/싸/짜 and diphthongs like 꽥/뜻 be typed without Shift.
+ * See docs/ALGORITHM.md rule 2.1 for the full explanation and worked
+ * examples (뜻, 꽥, 옛, 걲, 꺾).
+ *
+ * If the choseong doesn't have a tense form (or there is no choseong to
+ * tense), this falls through to the exact same jungseong-combination logic
+ * as hangul_ic_process_jamo(), so ordinary diphthongs (ㅘ, ㅙ, ㅚ, ...)
+ * still work unchanged. Only keyboards that set combination slot 2 reach
+ * this function at all (see the HANGUL_KEYBOARD_TYPE_JAMO_SUNARAE case in
+ * hangul_ic_process()), so every other keyboard's behavior is untouched. */
+static bool
+hangul_ic_process_jamo_sunarae(HangulInputContext *hic, ucschar ch)
+{
+    ucschar jong;
+    ucschar combined;
+
+    if (!hangul_is_jamo(ch) && ch > 0) {
+	hangul_ic_save_commit_string(hic);
+	hangul_ic_append_commit_string(hic, ch);
+	return true;
+    }
+
+    if (hic->buffer.jongseong) {
+	if (hangul_is_choseong(ch)) {
+	    jong = hangul_ic_choseong_to_jongseong(hic, ch);
+	    combined = hangul_keyboard_combine(hic->keyboard, 0,
+					       hic->buffer.jongseong, jong);
+	    if (hangul_is_jongseong(combined)) {
+		if (!hangul_ic_push(hic, combined)) {
+		    if (!hangul_ic_push(hic, ch)) {
+			return false;
+		    }
+		}
+	    } else {
+		hangul_ic_save_commit_string(hic);
+		if (!hangul_ic_push(hic, ch)) {
+		    return false;
+		}
+	    }
+	} else if (hangul_is_jungseong(ch)) {
+	    ucschar pop, peek;
+	    pop = hangul_ic_pop(hic);
+	    peek = hangul_ic_peek(hic);
+
+	    if (hangul_is_jongseong(peek)) {
+		ucschar choseong = hangul_jongseong_get_diff(peek,
+						 hic->buffer.jongseong);
+		if (choseong == 0) {
+		    hangul_ic_save_commit_string(hic);
+		    if (!hangul_ic_push(hic, ch)) {
+			return false;
+		    }
+		} else {
+		    hic->buffer.jongseong = peek;
+		    hangul_ic_save_commit_string(hic);
+		    hangul_ic_push(hic, choseong);
+		    if (!hangul_ic_push(hic, ch)) {
+			return false;
+		    }
+		}
+	    } else {
+		hic->buffer.jongseong = 0;
+		hangul_ic_save_commit_string(hic);
+		hangul_ic_push(hic, hangul_jongseong_to_choseong(pop));
+		if (!hangul_ic_push(hic, ch)) {
+		    return false;
+		}
+	    }
+	} else {
+	    goto sunarae_flush;
+	}
+    } else if (hic->buffer.jungseong) {
+	if (hangul_is_choseong(ch)) {
+	    if (hic->buffer.choseong) {
+		jong = hangul_ic_choseong_to_jongseong(hic, ch);
+		if (hangul_is_jongseong(jong)) {
+		    if (!hangul_ic_push(hic, jong)) {
+			if (!hangul_ic_push(hic, ch)) {
+			    return false;
+			}
+		    }
+		} else {
+		    hangul_ic_save_commit_string(hic);
+		    if (!hangul_ic_push(hic, ch)) {
+			return false;
+		    }
+		}
+	    } else {
+		if (hic->option_auto_reorder) {
+		    if (!hangul_ic_push(hic, ch)) {
+			if (!hangul_ic_push(hic, ch)) {
+			    return false;
+			}
+		    }
+		} else {
+		    hangul_ic_save_commit_string(hic);
+		    if (!hangul_ic_push(hic, ch)) {
+			return false;
+		    }
+		}
+	    }
+	} else if (hangul_is_jungseong(ch)) {
+	    ucschar tensed = 0;
+
+	    /* Sun-arae rule 2.1: same jungseong key twice tenses the
+	     * buffered choseong instead of combining as a jungseong. */
+	    if (hic->buffer.choseong && ch == hangul_ic_peek(hic)) {
+		tensed = hangul_keyboard_combine(hic->keyboard, 2,
+						 0, hic->buffer.choseong);
+	    }
+
+	    if (tensed) {
+		if (!hangul_ic_push(hic, tensed)) {
+		    return false;
+		}
+	    } else {
+		combined = hangul_keyboard_combine(hic->keyboard, 0,
+						   hic->buffer.jungseong, ch);
+		if (hangul_is_jungseong(combined)) {
+		    if (!hangul_ic_push(hic, combined)) {
+			return false;
+		    }
+		} else {
+		    hangul_ic_save_commit_string(hic);
+		    if (!hangul_ic_push(hic, ch)) {
+			return false;
+		    }
+		}
+	    }
+	} else {
+	    goto sunarae_flush;
+	}
+    } else if (hic->buffer.choseong) {
+	if (hangul_is_choseong(ch)) {
+	    combined = hangul_ic_combine(hic, hic->buffer.choseong, ch);
+	    if (hangul_is_jongseong(combined)) {
+		hic->buffer.choseong = 0;
+		ucschar pop = hangul_ic_pop(hic);
+		ucschar jong2 = hangul_choseong_to_jongseong(pop);
+		hangul_ic_push(hic, jong2);
+	    }
+
+	    if (!hangul_ic_push(hic, combined)) {
+		if (!hangul_ic_push(hic, ch)) {
+		    return false;
+		}
+	    }
+	} else {
+	    if (!hangul_ic_push(hic, ch)) {
+		if (!hangul_ic_push(hic, ch)) {
+		    return false;
+		}
+	    }
+	}
+    } else {
+	if (!hangul_ic_push(hic, ch)) {
+	    return false;
+	}
+    }
+
+    hangul_ic_save_preedit_string(hic);
+    return true;
+
+sunarae_flush:
+    hangul_ic_flush_internal(hic);
+    return false;
+}
+
 static bool
 hangul_ic_process_jaso(HangulInputContext *hic, ucschar ch)
 {
@@ -1099,6 +1275,8 @@ hangul_ic_process(HangulInputContext *hic, int ascii)
 	return hangul_ic_process_jaso(hic, c);
     case HANGUL_KEYBOARD_TYPE_ROMAJA:
 	return hangul_ic_process_romaja(hic, ascii, c);
+    case HANGUL_KEYBOARD_TYPE_JAMO_SUNARAE:
+	return hangul_ic_process_jamo_sunarae(hic, c);
     default:
 	return hangul_ic_process_jamo(hic, c);
     }
